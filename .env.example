# LearnQuest AI - Environment Variables Reference Template

# MySQL Database Configuration (XAMPP / Local MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=learnquest

# JWT Session Authentication Secret
JWT_SECRET=learnquest-ai-secret-key-production-replace-with-secure-hash

# AI Intelligence Engine (OpenAI API or Local LM Studio / Ollama)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Platform Operating Mode
# Set to true to run deterministic fallback pedagogy without requiring an active OpenAI key
NEXT_PUBLIC_DEMO_MODE=false
